{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "default_agent": "token-lean",
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 8000
  },
  "experimental": {
    "level_limit": 3
  },
  "agent": {
    "orchestrator": {
      "task_budget": 10
    }
  }
}
